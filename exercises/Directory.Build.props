<Project>
  <!-- Inherit the root settings: net10.0, Nullable, TreatWarningsAsErrors -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Each lesson lives in exercises/<lesson>/:
      *.cs              starting point with TODOs
      solution/*.cs     solution
      support/*.cs      support files you do not need to change
      *Tests.cs         tests, the same for starting point and solution
    The projects in exercises/ only include these files (see Directory.Build.targets).
  -->
  <PropertyGroup>
    <ExercisesDir>$(MSBuildThisFileDirectory)</ExercisesDir>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <RootNamespace>Exercises</RootNamespace>
    <SystemReactiveVersion>7.0.0</SystemReactiveVersion>
  </PropertyGroup>
</Project>
